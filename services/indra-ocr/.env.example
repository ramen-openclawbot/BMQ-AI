# Copy to ~/.local/share/bmq-indra-ocr/.env and chmod 600.
# Generate a real token with: openssl rand -hex 32
INDRA_OCR_TOKEN=replace-with-a-random-token-at-least-24-characters
INDRA_OCR_PORT=8792
INDRA_OCR_THREADS=4
INDRA_OCR_MAX_BYTES=12582912
INDRA_OCR_MAX_QUEUE=4
# Optional local model directory. Leave unset to use the package default.
# INDRA_OCR_MODEL_DIR=/path/to/indra-ocr-model
