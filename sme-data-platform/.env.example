# Non-secret settings only. Process/service manager must load configuration.
# No automatic fallback if this SSD is unmounted or not writable.
SME_DATA_ROOT=/Volumes/Samsung SSD 9100 PRO 1TB Media/BMQ/sme-data-platform
# Set fixed Supabase project origin and public/publishable key in host configuration.
# Values intentionally omitted. Never configure a service-role key here.
SME_SUPABASE_URL=
SME_SUPABASE_PUBLISHABLE_KEY=
# The Python service does not require an OpenAI key. Luna is called by the Edge layer.
